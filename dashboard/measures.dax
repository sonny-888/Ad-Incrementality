// Generated by dashboard/build_pbip.py; edit the MEASURES list there, not this file.


// ---------------------------------------------------------------- KPIS

[Caused per 100] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Caused per 100 credited conversions" )
// Format: 0

[Anyway per 100] =
100 - [Caused per 100]
// Format: 0

[Naive Multiple] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Naive effect of seeing an ad (multiple)" )
// Format: 0\x

[Causal Multiple] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Causal effect of seeing an ad (multiple)" )
// Format: 0.0\x

[Conversion Lift Adjusted] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Conversion lift, whole treated group" )
// Format: +0%;-0%;0%

[Top 20 Share] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Share of effect in top 20% of users" )
// Format: 0%

[Half Spend Keeps] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Half the spend keeps (conversions caused)" )
// Format: 0%

[Incremental Profit per Pound] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Incremental profit per £1 of ads" )
// Format: +£0.00;-£0.00;£0.00

[Dashboard Profit per Pound] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Dashboard profit per £1 of ads" )
// Format: +£0.00;-£0.00;£0.00

[Weaker Half Profit per Pound] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Weaker half profit per £1" )
// Format: +£0.00;-£0.00;£0.00

[Break Even ROAS] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Break-even dashboard ROAS, 30% margin" )
// Format: 0.0

[Break Even ROAS Weaker Half] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Break-even dashboard ROAS, weaker half" )
// Format: 0.0

[Smallest Geo Lift] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Smallest lift a 20-county, 12-week geo test detects" )
// Format: 0%

[CausalImpact False Alarms] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "CausalImpact-style false alarm rate" )
// Format: 0%

[DiD False Alarms] =
CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Difference-in-differences false alarm rate" )
// Format: 0%

[Holdout Users for 10pct Lift] =
DIVIDE ( CALCULATE ( SUM ( kpis[value] ), kpis[kpi] = "Users for a +10% conversion lift, 10% holdout" ), 1000000 )
// Format: 0.0\M


// ---------------------------------------------------------------- LIFT

[Rate Without Ad Effect] =
CALCULATE ( SUM ( naive_vs_caused[conversion_rate] ), naive_vs_caused[component] <> "Caused by the ad" )
// Format: 0.00%

[Rate Caused by Ad] =
CALCULATE ( SUM ( naive_vs_caused[conversion_rate] ), naive_vs_caused[component] = "Caused by the ad" )
// Format: 0.00%

[Conversion Lift] =
CALCULATE ( SUM ( lift_estimates[lift] ), lift_estimates[outcome] = "conversion" )
// Format: +0%;-0%;0%


// ---------------------------------------------------------------- FORMATTING

[Lift Bar Color] =
IF ( SELECTEDVALUE ( lift_estimates[estimate] ) = "Adjusted, doubly robust", "#5E81AC", "#CED6E2" )
// Format: text


// ---------------------------------------------------------------- TARGETING

[Captured Likely Buyers] =
CALCULATE ( AVERAGE ( targeting_curves[share_of_effect] ), targeting_curves[outcome] = "conversion", targeting_curves[x_axis] = "Share of ad spend used", targeting_curves[ranking] = "Likely buyers" )
// Format: 0%

[Captured Uplift Model] =
CALCULATE ( AVERAGE ( targeting_curves[share_of_effect] ), targeting_curves[outcome] = "conversion", targeting_curves[x_axis] = "Share of ad spend used", targeting_curves[ranking] = "Uplift model (X-learner)" )
// Format: 0%

[Captured Per Ad View] =
CALCULATE ( AVERAGE ( targeting_curves[share_of_effect] ), targeting_curves[outcome] = "conversion", targeting_curves[x_axis] = "Share of ad spend used", targeting_curves[ranking] = "Effect per ad view" )
// Format: 0%

[Random Targeting] =
IF ( NOT ISBLANK ( [Captured Likely Buyers] ), AVERAGE ( targeting_curves[x] ) )
// Format: 0%


// ---------------------------------------------------------------- MONEY

[Profit All Spend] =
AVERAGE ( money_sensitivity[profit_per_pound_all_spend] )
// Format: +£0.00;-£0.00;£0.00

[Profit Weaker Half] =
AVERAGE ( money_sensitivity[profit_per_pound_other_half] )
// Format: +£0.00;-£0.00;£0.00

[Break Even ROAS Cell] =
AVERAGE ( break_even[break_even_dashboard_roas] )
// Format: 0.0


// ---------------------------------------------------------------- FORMATTING

[Profit All Spend Color] =
IF ( [Profit All Spend] < 0, "#F3DDE0", "#DCE5F0" )
// Format: text

[Profit Weaker Half Color] =
IF ( [Profit Weaker Half] < 0, "#F3DDE0", "#DCE5F0" )
// Format: text


// ---------------------------------------------------------------- MEASUREMENT

[False Alarm Rate] =
AVERAGE ( geo_designs[false_alarm_rate] )
// Format: 0%


// ---------------------------------------------------------------- FORMATTING

[Method Color] =
IF ( SELECTEDVALUE ( geo_designs[method] ) = "CausalImpact-style", "#BF616A", "#5E81AC" )
// Format: text


// ---------------------------------------------------------------- MEASUREMENT

[Smallest Lift DiD] =
CALCULATE ( AVERAGE ( geo_designs[min_detectable_lift] ), geo_designs[method] = "Difference-in-differences" )
// Format: 0%

[Users Needed] =
CALCULATE ( SUM ( holdout_users[users_millions] ), holdout_users[outcome] = "conversion" )
// Format: 0.0\M
